# Application paths and service URLs (phase A)

# Root for SQLite, object store, embedding cache
DATA_DIR=./data

# SQLAlchemy URL (SQLite file under DATA_DIR by default)
SQLITE_URL=sqlite+aiosqlite:///./data/rageval.db

# Qdrant (docker compose service)
QDRANT_URL=http://localhost:6333

# Embedding: hash (default, fast/tests) | sentence_transformers (needs pip install -e ".[ml]")
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Hugging Face token (https://huggingface.co/settings/tokens) — rate limits + gated models
# Required to silence "unauthenticated requests" warnings in API logs.
HF_TOKEN=

# GigaChat: path to Russian Trusted Root CA file or directory (see certs/README.md)
# In Docker image this defaults to /etc/ssl/certs/rageval/ca-bundle.pem when certs were present at build.
# GIGACHAT_CA_BUNDLE=./certs

# Local HF cache (Docker Compose mounts named volume hf_models at /models)
# HF_HOME=./data/models

# Optional: override env file discovery
# RAG_EVAL_ENV_FILE=.env

# Frontend (apps/web/.env.local): NEXT_PUBLIC_API_URL=http://localhost:8000
